{
  "appId": "com.deepusiva.gameverse",
  "appName": "GameVerse",
  "webDir": ".",
  "bundledWebRuntime": false,
  "android": {
    "buildOptions": {
      "keystorePath": "android/gameverse.keystore",
      "keystoreAlias": "gameverse",
      "releaseType": "APK"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0a0a0a",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0a0a0a"
    }
  }
}
